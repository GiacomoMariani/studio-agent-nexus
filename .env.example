# =============================================================================
# Studio Agent Nexus — environment configuration
# =============================================================================
#
# Copy this file to .env for local development:
#
#   cp .env.example .env
#
# Do not commit real secrets in .env.
# Pass to Docker with:
#
#   docker run --env-file .env ...
#
# =============================================================================


# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------
# Required for all protected endpoints.
# Clients must send this value in the X-API-Key header.
APP_API_KEY=change-me-local-dev-key


# -----------------------------------------------------------------------------
# SQLite storage
# -----------------------------------------------------------------------------
# Main application database: documents, chunks, ingestion jobs,
# evaluation results, usage tracking, query logs.
APP_DB_PATH=app.db

# Temporary staging database for uploaded text during background ingestion.
APP_UPLOADED_TEXT_DB_PATH=uploaded_texts.db


# -----------------------------------------------------------------------------
# Uploaded-text retention
# -----------------------------------------------------------------------------
# Retention window for stale staged uploads (hours).
# Keep this larger than the maximum expected queue delay + processing delay.
APP_UPLOADED_TEXT_CLEANUP_MAX_AGE_HOURS=24


# -----------------------------------------------------------------------------
# Extraction backend
# -----------------------------------------------------------------------------
# Supported values:
#   rule        — deterministic rule-based extractor; no external LLM calls
#   mock_llm    — deterministic mock LLM extractor for prompt-path testing
#   mock_llm_json — JSON-structured mock LLM output
EXTRACTOR_TYPE=rule


# -----------------------------------------------------------------------------
# Game project integration
# -----------------------------------------------------------------------------
# Supported values:
#   local             — in-memory fixture data; no external calls
#   http              — calls an external game project management API
#   http_with_fallback — calls external API first, falls back to local fixtures
GAME_PROJECT_CLIENT_TYPE=local

# Required when GAME_PROJECT_CLIENT_TYPE=http or http_with_fallback.
GAME_PROJECT_API_BASE_URL=

# Optional bearer token for the external game project API.
GAME_PROJECT_API_KEY=


# -----------------------------------------------------------------------------
# Document QA answerer
# -----------------------------------------------------------------------------
# rule = deterministic local answerer; no external LLM calls
# llm  = prompt-based answerer using DOCUMENT_QA_MODEL_CLIENT_TYPE
DOCUMENT_ANSWERER_TYPE=rule

# Document QA model client
# fake   = deterministic local prompt-path test client; no external calls
# openai = real OpenAI Responses API client; requires OPENAI_API_KEY
DOCUMENT_QA_MODEL_CLIENT_TYPE=fake

# For fake mode, keep fake-document-qa.
# For openai mode, use a real model such as gpt-4.1-mini.
DOCUMENT_QA_MODEL_NAME=fake-document-qa

# If true, failed/misconfigured LLM setup falls back to the rule answerer.
# Recommended true for demos and portfolio deployment.
DOCUMENT_QA_FALLBACK_TO_RULE=true

# Required only when DOCUMENT_QA_MODEL_CLIENT_TYPE=openai.
# Keep this empty in .env.example. Set it only in your local .env or
# hosting provider secrets.
OPENAI_API_KEY=
