# =============================================================================
# Studio Agent Nexus — environment configuration
# =============================================================================
#
# Copy this file to .env for local development:
#
#   cp .env.example .env
#
# Do not commit real secrets in .env.
# Pass to Docker with:
#
#   docker run --env-file .env ...
#
# =============================================================================


# -----------------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------------
# Required for all protected endpoints.
# Clients must send this value in the X-API-Key header.
APP_API_KEY=change-me-local-dev-key


# -----------------------------------------------------------------------------
# SQLite storage
# -----------------------------------------------------------------------------
# Main application database: documents, chunks, ingestion jobs,
# evaluation results, usage tracking, query logs.
APP_DB_PATH=app.db

# Temporary staging database for uploaded text during background ingestion.
APP_UPLOADED_TEXT_DB_PATH=uploaded_texts.db


# -----------------------------------------------------------------------------
# Uploaded-text retention
# -----------------------------------------------------------------------------
# Retention window for stale staged uploads (hours).
# Keep this larger than the maximum expected queue delay + processing delay.
APP_UPLOADED_TEXT_CLEANUP_MAX_AGE_HOURS=24


# -----------------------------------------------------------------------------
# Extraction backend
# -----------------------------------------------------------------------------
# Supported values:
#   rule        — deterministic rule-based extractor; no external LLM calls
#   mock_llm    — deterministic mock LLM extractor for prompt-path testing
#   mock_llm_json — JSON-structured mock LLM output
EXTRACTOR_TYPE=rule


# -----------------------------------------------------------------------------
# Game project integration
# -----------------------------------------------------------------------------
# Supported values:
#   local             — in-memory fixture data; no external calls
#   http              — calls an external game project management API
#   http_with_fallback — calls external API first, falls back to local fixtures
GAME_PROJECT_CLIENT_TYPE=local

# Required when GAME_PROJECT_CLIENT_TYPE=http or http_with_fallback.
GAME_PROJECT_API_BASE_URL=

# Optional bearer token for the external game project API.
GAME_PROJECT_API_KEY=


# -----------------------------------------------------------------------------
# Document QA answerer
# -----------------------------------------------------------------------------
# rule = deterministic local answerer; no external LLM calls
# llm  = prompt-based answerer using DOCUMENT_QA_MODEL_CLIENT_TYPE (default)
DOCUMENT_ANSWERER_TYPE=llm

# Document QA model client
# gemini = free Google Gemini via the google-genai SDK; requires GEMINI_API_KEY (default)
# groq   = fast GroqCloud inference via the groq SDK; requires GROQ_API_KEY
# openai = real OpenAI Responses API client; requires OPENAI_API_KEY
# fake   = deterministic local prompt-path test client; no external calls
DOCUMENT_QA_MODEL_CLIENT_TYPE=gemini

# For gemini mode, a free Flash model such as gemini-2.5-flash.
# For groq mode, a fast model such as llama-3.1-8b-instant.
# For openai mode, a real model such as gpt-4.1-mini.
# For fake mode, keep fake-document-qa.
DOCUMENT_QA_MODEL_NAME=gemini-2.5-flash

# If true, a failed/misconfigured LLM setup falls back to the rule answerer.
# Recommended true for demos and portfolio deployment.
DOCUMENT_QA_FALLBACK_TO_RULE=true

# Minimum retrieval relevance (raw cosine, 0–1) a chunk must reach to be retrieved/cited.
# Chunks below this floor are dropped, so weakly-relevant / off-topic questions return the
# safe fallback instead of a misleading snippet. 0 disables the floor. Tuned for the demo
# docs (in-scope questions score ≥ ~0.43; off-topic ≤ ~0.25).
RETRIEVAL_MIN_SCORE=0.3

# Classifier for /classify (reuses the Document QA provider/model above).
# llm  = LLM classification, falling back to the rule classifier on error or missing key (default)
# rule = deterministic keyword classifier; no external calls
CLASSIFIER_TYPE=llm

# Summarizer for /summarize (reuses the Document QA provider/model above).
# llm  = LLM summarization, falling back to the rule summarizer on error or missing key (default)
# rule = first-N-sentences extractive summarizer; no external calls
SUMMARIZER_TYPE=llm

# Answerer for the generic /answer endpoint (question + provided context).
# Distinct from DOCUMENT_ANSWERER_TYPE above, which controls /documents/ask (RAG).
# llm  = LLM answer grounded in the given context, falling back to rule on error or missing key (default)
# rule = word-overlap sentence picker; no external calls
ANSWERER_TYPE=llm

# Chatbot for /chat (reuses the Document QA provider/model above).
# llm  = LLM assistant with a scoped persona, falling back to the rule echo on error or missing key (default)
# rule = canned echo chatbot; no external calls
CHATBOT_TYPE=llm

# Risk & contradiction detection for POST /admin/risks/detect (reuses the Document QA
# provider/model above).
# llm  = LLM cross-document analysis, falling back to the rule detector on error or missing
#        key (default)
# rule = deterministic heuristics tuned to the demo docs; no external calls
RISK_DETECTOR_TYPE=llm

# If true, a failed/misconfigured LLM risk detector falls back to the rule detector.
RISK_DETECTION_FALLBACK_TO_RULE=true

# Jira-task draft generation for POST /admin/jira-tasks/generate (reuses the Document QA
# provider/model above). Drafts are ephemeral — generated, shown on the Board, never stored.
# llm  = LLM proposes Jira-shaped task drafts, falling back to the rule generator on error or
#        missing key (default)
# rule = deterministic heuristics (cue sentences → drafts); no external calls
JIRA_TASK_GENERATOR_TYPE=llm

# If true, a failed/misconfigured LLM task generator falls back to the rule generator.
JIRA_TASK_GENERATION_FALLBACK_TO_RULE=true

# Ask-page "related & suggested tasks" (POST /documents/ask/task-suggestions). Related existing
# board tasks are matched with local embeddings (no LLM tokens); new suggestions reuse the
# Jira-task generator above. The affordance is shown only when an LLM actually answered.
# Minimum cosine similarity (0–1) for an existing board task to count as "related".
ASK_TASK_MATCH_MIN_SCORE=0.3
# Max number of suggested new tasks returned per request.
ASK_TASK_SUGGEST_MAX=8


# -----------------------------------------------------------------------------
# Frontend display
# -----------------------------------------------------------------------------
# Max snippets shown per source group on the Ask page ("..." marks hidden ones).
SOURCE_SNIPPETS_SHOWN=3


# Required when DOCUMENT_QA_MODEL_CLIENT_TYPE=gemini.
# Free-tier note: Google may use free-tier requests to improve their models —
# do not send confidential or customer data through the free Gemini tier.
# Keep this empty in .env.example. Set it only in your local .env or
# hosting provider secrets.
GEMINI_API_KEY=

# Required when DOCUMENT_QA_MODEL_CLIENT_TYPE=groq.
# Keep this empty in .env.example. Set it only in your local .env or
# hosting provider secrets.
GROQ_API_KEY=

# Required only when DOCUMENT_QA_MODEL_CLIENT_TYPE=openai.
# Keep this empty in .env.example. Set it only in your local .env or
# hosting provider secrets.
OPENAI_API_KEY=
